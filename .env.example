DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-pro
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=uk-website-rag-dev

# GitHub OAuth for /contribute/admin
AUTH_SECRET=generate_a_random_auth_secret
AUTH_GITHUB_ID=github_oauth_app_client_id
AUTH_GITHUB_SECRET=github_oauth_app_client_secret
ADMIN_GITHUB_LOGINS=your_github_username

# GitHub App installed on the private intake and public website repositories
GITHUB_APP_ID=github_app_id
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_INSTALLATION_ID=github_app_installation_id
CONTRIBUTION_GITHUB_REPOSITORY=owner/private-contributions
PUBLIC_GITHUB_REPOSITORY=owner/uk-website
GITHUB_WEBHOOK_SECRET=shared_webhook_secret

# Private Cloudflare R2 intake bucket
R2_ACCOUNT_ID=cloudflare_account_id
R2_ACCESS_KEY_ID=r2_access_key_id
R2_SECRET_ACCESS_KEY=r2_secret_access_key
R2_PRIVATE_BUCKET=uk-website-contributions-private
